---
/**
 * The board shell. Static HTML — renders on the server, ships no JavaScript.
 * Live regions are islands placed by the page, never by this layout.
 *
 * Layout follows the UniFi console pattern: a narrow icon rail, a top
 * header strip owned by the page, and content panels barely lifted off the
 * ground with hairline borders. No shadows, no gradients, radius 4px.
 */
import '../styles/global.css';
import { TriangleAlert, LayoutGrid, Layers, Settings } from '@lucide/svelte';

interface Props {
  title: string;
  section?: string;
}

const { title, section = 'alarms' } = Astro.props;

const nav = [
  { icon: TriangleAlert, label: 'Alarms', href: '/', key: 'alarms' },
  { icon: LayoutGrid, label: 'Overview', href: '/overview', key: 'overview' },
  { icon: Layers, label: 'Templates', href: '/templates', key: 'templates' },
  { icon: Settings, label: 'Settings', href: '/settings', key: 'settings' },
];
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Log-driven alarms for homelabs. Oarfish clusters your logs into templates and judges each one once, so it wakes you only when something earns it." />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/logo.png" />
  </head>
  <body class="min-h-dvh">
    <div class="flex min-h-dvh">
      <nav class="flex w-14 shrink-0 flex-col items-center gap-1 border-r border-line bg-l1 py-3" aria-label="Sections">
        <a
          href="/"
          class="mb-3 grid size-9 place-items-center overflow-hidden rounded-(--radius-ui) bg-l2"
          title="oarfish home"
          aria-label="oarfish home"
        >
          <img src="/logo.png" alt="" width="36" height="36" class="size-9 object-cover" />
        </a>
        {nav.map(({ icon: Icon, label, href, key }) => (
          <a
            href={href}
            title={label}
            aria-label={label}
            aria-current={key === section ? 'page' : undefined}
            class:list={[
              'grid size-10 place-items-center rounded-(--radius-ui) transition-colors duration-[120ms]',
              key === section
                ? 'bg-accent-soft text-accent'
                : 'text-ink-3 hover:bg-l2 hover:text-ink',
            ]}
          >
            <Icon size={18} strokeWidth={key === section ? 2.25 : 1.75} />
          </a>
        ))}
        <div class="mt-auto flex flex-col items-center gap-1" aria-hidden="true">
          <span class="size-1 rounded-full bg-line-2"></span>
        </div>
      </nav>

      <div class="flex min-w-0 flex-1 flex-col">
        <slot />
      </div>
    </div>
  </body>
</html>
