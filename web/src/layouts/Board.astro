---
/**
 * The board shell. Static: everything that does not change between alarms.
 * Live regions are islands placed by the page, not by this layout.
 */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
