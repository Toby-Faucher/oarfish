---
import Board from '../layouts/Board.astro';
import AlarmList from '../components/AlarmList.svelte';
import Template from '../components/Template.svelte';
import ConnectionPulse from '../components/ConnectionPulse.svelte';
import type { Alarm, Slot } from '../lib/bindings/oarfish';

// Placeholder data until oarfish-api exists. The shape is generated from
// oarfish-core, so this breaks loudly if the daemon's Alarm ever changes.
const alarms: Alarm[] = [
  {
    id: '01K5ZG7Q2M0000000000000001',
    template_id: 't_' + '8f3c21a9'.repeat(8),
    template: 'EXT4-fs error (device <VAR:DEV>): inode #<VAR:NUM>: comm <VAR:PROC>',
    severity: 'critical',
    host: 'nas01',
    count: 14,
    opened_at: '2026-09-18T03:14:07Z',
  },
  {
    id: '01K5ZG7Q2M0000000000000002',
    template_id: 't_' + '4b19c7e2'.repeat(8),
    template: 'smbd[<VAR:NUM>]: session teardown for <VAR:USER> from <VAR:IP>',
    severity: 'major',
    host: 'nas01',
    count: 61,
    opened_at: '2026-09-18T03:14:41Z',
  },
  {
    id: '01K5ZG7Q2M0000000000000003',
    template_id: 't_' + 'c70da155'.repeat(8),
    template: 'certificate for <VAR:HOST> expires in <VAR:NUM> days',
    severity: 'minor',
    host: 'proxy01',
    count: 1,
    opened_at: '2026-09-18T01:02:19Z',
  },
  {
    id: '01K5ZG7Q2M0000000000000004',
    template_id: 't_' + 'a2e64b03'.repeat(8),
    template: 'new template seen on <VAR:HOST>',
    severity: 'info',
    host: 'pve01',
    count: 3,
    opened_at: '2026-09-17T22:40:52Z',
  },
];

const template =
  'EXT4-fs error (device <VAR:DEV>): ext4_find_entry:<VAR:NUM>: inode #<VAR:NUM>: ' +
  'comm <VAR:PROC>: reading directory lblock <VAR:NUM>';

const slots: Slot[] = [
  { name: 'DEV',  pattern: '/\\b(sd[a-z]\\d*|nvme\\d+n\\d+p?\\d*)\\b/', seen: 4 },
  { name: 'NUM',  pattern: '/\\b\\d+\\b/',                              seen: 812 },
  { name: 'PROC', pattern: '/comm ([a-z_][a-z0-9_-]*)/',                seen: 6 },
];
---

<Board title="oarfish — alarms" section="alarms">
  <header class="flex items-center gap-4 border-b border-line bg-l1 px-5 py-2.5">
    <h1 class="label text-[14px]">Alarms</h1>
    <div class="ml-auto"><ConnectionPulse client:load /></div>
  </header>

  <main class="grid min-w-0 flex-1 gap-4 p-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
    <!-- island: holds density state, and takes SSE once the daemon is wired -->
    <section class="self-start overflow-hidden rounded-(--radius-ui) border border-line bg-l1">
      <AlarmList {alarms} client:load />
    </section>

    <!-- static: the signature component, server-rendered, no JavaScript -->
    <section class="self-start overflow-hidden rounded-(--radius-ui) border border-line bg-l1">
      <div class="flex items-center gap-2 border-b border-line bg-l2 px-3.5 py-2 font-mono text-[10px] tracking-[0.12em] text-ink-3 uppercase">
        <span>t_8f3c21a9</span>
        <span class="ml-auto normal-case tracking-normal">14 occurrences · 1 host</span>
      </div>
      <div class="p-5">
        <Template {template} {slots} />
      </div>
    </section>
  </main>
</Board>
